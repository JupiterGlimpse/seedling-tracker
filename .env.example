# ========================================
# Notion配置（推荐 - 配置超简单！）
# ========================================
# 1. 访问 https://www.notion.so/my-integrations 创建Integration
# 2. 复制 Internal Integration Token
NOTION_API_KEY=secret_your_token_here

# 3. 在Notion创建页面，复制URL中的32位ID
NOTION_PAGE_ID=your_page_id_here

# 4. 首次运行后会自动创建数据库，复制输出的ID到这里（可选）
# NOTION_JOBS_DB_ID=your_jobs_db_id
# NOTION_APPLICATIONS_DB_ID=your_apps_db_id
# NOTION_STATS_DB_ID=your_stats_db_id


# ========================================
# Google Sheets配置（可选 - 配置较复杂）
# ========================================
# SPREADSHEET_ID=your_spreadsheet_id_here
# GOOGLE_CREDENTIALS_PATH=credentials.json


# ========================================
# 求职配置
# ========================================
JOB_KEYWORD=AI产品经理
JOB_CITY=北京
JOB_MAX_RESULTS=20


# ========================================
# Boss直聘配置（可选）
# ========================================
# BOSS_USERNAME=your_phone_number
# BOSS_PASSWORD=your_password


# ========================================
# Claude API配置（用于AI匹配度评分，可选）
# ========================================
# ANTHROPIC_API_KEY=your_api_key_here
